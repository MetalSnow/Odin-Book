{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./generated/prisma",
    "outDir": "./dist/generated/prisma",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": ["generated/prisma/**/*.ts"]
}
